{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"rootDir": "./src",
		"moduleResolution": "node",
		"baseUrl": "./src",
		"ignoreDeprecations": "6.0",
		"lib": [
			"es2020"
		],
		"types": [
			"node",
			"jest"
		],
		"paths": {
			"@api/*": [ "api/v1/*" ],
			"@constants/*": [ "shared/constants/*" ],
			"@services/*": [ "shared/services/*" ],

			"@workers/*": [ "workers/*" ],

			"@config/*": [ "core/config/*" ],
			"@contexts/*": [ "core/contexts/*" ],
			"@providers/*": ["core/providers/*"],
			"@http/*": [ "core/http/*" ],
			"@middlewares/*": [ "core/middlewares/*" ],
			"@utils/*": [ "core/utils/*" ],

			"@database": [ "database" ],
			"@models/*": [ "database/maindb/models/*" ]
		},
		"resolveJsonModule": true,
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"src/__tests__"
	]
}
